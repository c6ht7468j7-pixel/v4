<script>const builtinBooks=[{"id":"rotkaeppchen","title":"Rotkäppchen","author":"Brüder Grimm","description":"Ein Mädchen besucht seine Großmutter und begegnet im Wald einem Wolf.","questions":[{"q":"Warum wird das Mädchen Rotkäppchen genannt?","a":["Weil es rote Schuhe trägt","Weil es ein rotes Käppchen trägt","Weil es rote Haare hat","Weil es in einem roten Haus wohnt"],"c":1},{"q":"Wen soll Rotkäppchen besuchen?","a":["Seine Großmutter","Seinen Bruder","Seine Lehrerin","Seinen Onkel"],"c":0},{"q":"Was bringt Rotkäppchen zur Großmutter?","a":["Brot und Käse","Kuchen und Wein","Äpfel und Milch","Suppe und Wasser"],"c":1},{"q":"Wem begegnet Rotkäppchen im Wald?","a":["Einem Bären","Einem Fuchs","Einem Wolf","Einem Hasen"],"c":2},{"q":"Was empfiehlt der Wolf Rotkäppchen?","a":["Blumen zu pflücken","Nach Hause zu laufen","Auf einen Baum zu klettern","Im Wald zu schlafen"],"c":0},{"q":"Wohin geht der Wolf zuerst?","a":["Zum Markt","Zum Haus der Großmutter","Zur Schule","Zum Fluss"],"c":1},{"q":"Als wen verkleidet sich der Wolf?","a":["Als Jäger","Als Rotkäppchen","Als Großmutter","Als Müller"],"c":2},{"q":"Wer rettet Rotkäppchen und die Großmutter?","a":["Ein Jäger","Ein Bauer","Ein König","Ein Fischer"],"c":0},{"q":"Was fällt Rotkäppchen am Wolf besonders auf?","a":["Seine großen Augen, Ohren und sein Maul","Seine kleinen Füße","Seine bunten Flügel","Sein langer Schnabel"],"c":0},{"q":"Was nimmt sich Rotkäppchen am Ende vor?","a":["Nie wieder die Großmutter zu besuchen","Nicht mehr allein vom Weg abzugehen","Immer im Wald zu schlafen","Dem Wolf zu folgen"],"c":1}]},{"id":"haensel-gretel","title":"Hänsel und Gretel","author":"Brüder Grimm","description":"Zwei Geschwister verirren sich im Wald und entdecken ein ungewöhnliches Haus.","questions":[{"q":"Wie heißen die beiden Geschwister?","a":["Hans und Greta","Hänsel und Gretel","Heinrich und Gerda","Anton und Marie"],"c":1},{"q":"Warum werden die Kinder in den Wald geführt?","a":["Weil die Familie zu wenig zu essen hat"