<header class="site-title"><h1>LESEHELDEN-CLUB</h1><p>LESEN · FRAGEN · PUNKTE · ERFOLGE</p></header>

<div class="start-layout"><div class="login-column"><section id="login" class="box"><h2>BENUTZER-ANMELDUNG</h2><label>BENUTZERNAME:</label><br><input id="username" placeholder="z. B. Emma"><br><label>PASSWORT:</label><br><input id="password" type="password" placeholder="Passwort"><br><button onclick="login()">[ ANMELDEN ]</button><p id="loginError" class="error"></p></section><section id="communityStats" class="box" aria-live="polite"><h2>GEMEINSAME STATISTIKEN</h2><p>ALLE NUTZER, MODERATOREN UND ADMINS AUF DIESEM GERÄT.</p><div id="communityStatsContent" class="community-stats"></div></section></div><section id="register" class="box"><h2>NEU REGISTRIEREN</h2><label>BENUTZERNAME:</label><br><input id="registerUsername" placeholder="z. B. Emma"><br><label>PASSWORT:</label><br><input id="registerPassword" type="password" placeholder="Passwort"><br><label>PASSWORT WIEDERHOLEN:</label><br><input id="registerPasswordRepeat" type="password" placeholder="Passwort wiederholen"><br><label>EINLADUNGSCODE:</label><br><input id="inviteCode" placeholder="Beim ersten Benutzer nicht nötig"><br><button onclick="registerUser()">[ REGISTRIEREN ]</button><p id="registerError" class="error"></p><div class="registration-note"><strong>WICHTIG:</strong> Bitte keinen Klarnamen verwenden. Eine E-Mail-Adresse ist nicht erforderlich. Bewahre Benutzername und Passwort sicher auf: Es gibt keine Möglichkeit, Konten oder Passwörter wiederherzustellen.</div></section></div>
<section id="portal" class="hidden"><div class="box"><div class="menu-header"><h2>HAUPTMENÜ</h2></div><div class="status">BENUTZER: <span id="userName">-</span><br>ROLLE: <span id="userRole">NUTZER</span><br>PUNKTE: <span id="totalPoints">0</span><br>LEVEL: <span id="userLevel">1</span><br>ABGESCHLOSSENE QUIZ: <span id="completedCount">0</span><br>ERFOLGE: <span id="achievementCount">0</span></div><button onclick="showBooks()">[ 1 ] BIBLIOTHEK</button><button id="bookManageButton" class="hidden" onclick="showBookManagement()">[ 2 ] BUCH UND QUIZ HINZUFÜGEN</button><button onclick="showProgress()">[ 3 ] FORTSCHRITT</button><button onclick="showAchievements()">[ 4 ] ERFOLGE</button><button onclick="showPasswordChange()">[ 5 ] PASSWORT ÄNDERN</button><button onclick="showLeaderboard()">[ 6 ] BESTENLISTE</button><button onclick="showCertificate()">[ 7 ] URKUNDE</button><button id="adminManageButton" class="hidden" onclick="showUserManagement()">[ 8 ] BENUTZERVERWALTUNG</button><button onclick="logout()">[ 9 ] ABMELDEN</button></div>
